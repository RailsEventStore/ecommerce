<div class="max-w-md mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight">New application</h1>
    <p class="mt-1 text-sm text-slate-500">Tell us how much coverage you need — we'll evaluate the risk and quote a premium.</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <%= form_with url: applications_path, method: :post do %>
      <%= hidden_field_tag :application_id, @application_id %>

      <label for="coverage_amount" class="block text-sm font-medium text-slate-700">Coverage amount</label>
      <div class="mt-1 relative">
        <span class="absolute inset-y-0 left-3 flex items-center text-slate-400">$</span>
        <%= number_field_tag :coverage_amount, nil, min: 1, step: 0.01, required: true, placeholder: "10,000.00", class: "block w-full rounded-md border-slate-300 pl-7 text-sm" %>
      </div>
      <p class="mt-2 text-xs text-slate-400">The premium is a percentage of coverage, set by the risk class.</p>

      <div class="mt-6 flex items-center gap-3">
        <%= submit_tag "Submit application", class: "px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium rounded-lg shadow-sm cursor-pointer" %>
        <%= link_to "Back", applications_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
      </div>
    <% end %>
  </div>
</div>
