<div class="w-full">
  <h1 class="text-2xl font-bold mb-4">New application</h1>

  <%= form_with url: applications_path, method: :post do %>
    <%= hidden_field_tag :application_id, @application_id %>

    <label for="coverage_amount" class="block font-bold">Coverage amount</label>
    <%= number_field_tag :coverage_amount, nil, min: 1, step: 0.01, required: true, class: "mt-1 block border-gray-300 rounded-md" %>

    <div class="mt-4">
      <%= submit_tag "Submit application", class: "px-3 py-2 bg-blue-600 text-white rounded-md" %>
      <%= link_to "Back", applications_path, class: "px-3 py-2 border rounded-md" %>
    </div>
  <% end %>
</div>
