<div class="w-full">
  <div class="flex justify-between items-center mb-4">
    <h1 class="text-2xl font-bold">Applications</h1>
    <div>
      <%= link_to "New application", new_application_path, class: "px-3 py-2 bg-blue-600 text-white rounded-md" %>
      <%= link_to "Policies", policies_path, class: "px-3 py-2 border rounded-md" %>
      <%= link_to "Claims", claims_path, class: "px-3 py-2 border rounded-md" %>
    </div>
  </div>

  <table class="w-full">
    <thead>
    <tr>
      <th class="text-left py-2">Application</th>
      <th class="text-left py-2">Coverage</th>
      <th class="text-left py-2">Risk class</th>
      <th class="text-left py-2">Premium</th>
      <th class="text-left py-2">State</th>
      <th class="text-left py-2">Actions</th>
    </tr>
    </thead>

    <tbody>
    <% @applications.each do |application| %>
      <tr class="border-t">
        <td class="py-2"><%= application.application_id %></td>
        <td class="py-2"><%= number_to_currency(application.coverage_amount) %></td>
        <td class="py-2"><%= application.risk_class %></td>
        <td class="py-2"><%= number_to_currency(application.premium) if application.premium %></td>
        <td class="py-2"><%= application.state %></td>
        <td class="py-2">
          <% case application.state %>
          <% when "submitted" %>
            <%= form_with url: evaluate_risk_application_path(application.application_id), method: :post do %>
              <%= select_tag :risk_class, options_for_select(%w[low standard high], "standard") %>
              <%= submit_tag "Evaluate risk", class: "px-2 py-1 border rounded-md" %>
            <% end %>
          <% when "risk evaluated" %>
            <%= button_to "Calculate premium", calculate_premium_application_path(application.application_id), class: "px-2 py-1 border rounded-md" %>
          <% when "priced" %>
            <%= button_to "Accept offer", accept_offer_application_path(application.application_id), class: "px-2 py-1 border rounded-md" %>
          <% end %>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
</div>
