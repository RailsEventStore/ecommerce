<div class="max-w-md mx-auto">
  <div class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight">Report a loss</h1>
    <p class="mt-1 text-sm text-slate-500">Notify us of a loss on one of your policies.</p>
  </div>

  <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
    <%= form_with url: claims_path, method: :post do %>
      <%= hidden_field_tag :claim_id, @claim_id %>

      <label for="policy_id" class="block text-sm font-medium text-slate-700">Policy</label>
      <%= select_tag :policy_id, options_from_collection_for_select(@policies, :policy_id, :policy_id), class: "mt-1 block w-full rounded-md border-slate-300 text-sm" %>

      <label for="description" class="block text-sm font-medium text-slate-700 mt-4">Description</label>
      <%= text_field_tag :description, "", required: true, placeholder: "What happened?", class: "mt-1 block w-full rounded-md border-slate-300 text-sm" %>

      <div class="mt-6 flex items-center gap-3">
        <%= submit_tag "Report loss", class: "px-4 py-2 bg-sky-600 hover:bg-sky-700 text-white text-sm font-medium rounded-lg shadow-sm cursor-pointer" %>
        <%= link_to "Back", claims_path, class: "px-4 py-2 text-sm font-medium text-slate-600 hover:text-slate-900" %>
      </div>
    <% end %>
  </div>
</div>
